# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must never be committed.

# Google AI Studio API key used by all Gemini-backed agents (required).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Optional: override the database location (defaults to sqlite:///db/synthetic_data.db).
# Any SQLAlchemy-compatible URL works, e.g. postgresql+psycopg://user:pass@host/dbname
# DATABASE_URL=sqlite:///db/synthetic_data.db
